-- Variables
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local SilentAimEnabled = false

-- Fungsi nyari target Murderer secara instan
local function GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if player.Character:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife") then
                return player.Character
            end
        end
    end
    return nil
end

-- ==============================================================================
-- [ULTIMATE REMOTE INTERCEPTION - 100% WORK & NO LAG]
-- ==============================================================================
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Args = {...}
    local Method = getnamecallmethod()
    
    -- Memotong jalur data saat game mengirimkan trigger tembakan ke server
    if SilentAimEnabled and Method == "FireServer" then
        -- Deteksi nama RemoteEvent peluru MM2 (biasanya "ShootGun" atau lewat tool gun)
        if Self.Name == "ShootGun" or Self.Parent == LocalPlayer.Character:FindFirstChild("Gun") then
            local Murderer = GetMurderer()
            if Murderer then
                -- Target dada murni (Vector3)
                local Chest = Murderer:FindFirstChild("UpperTorso") or Murderer:FindFirstChild("Torso") or Murderer:FindFirstChild("HumanoidRootPart")
                if Chest then
                    -- Cari di mana argumen posisi Vector3 berada, lalu timpa dengan posisi dada Murderer
                    for i, arg in pairs(Args) do
                        if typeof(arg) == "Vector3" then
                            Args[i] = Chest.Position -- Paksa koordinat 3D murni ke dada target!
                            break
                        end
                    end
                end
            end
        end
    end
    
    return OldNamecall(Self, unpack(Args))
end)

