-- [[ ToBlUt GpT V1 - MM2 Silent Aim Setup with Rayfield UI ]] --

-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Membuat Window Utama
local Window = Rayfield:CreateWindow({
   Name = "ToBlUt GpT V1 - Murder Mystery 2",
   LoadingTitle = "Loading Sheriff Suite...",
   LoadingSubtitle = "by barzpuqi",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = nil,
      FileName = "ToBlUtMM2"
   },
   Discord = {
      Enabled = false,
      Invite = "",
      RememberJoins = false
   },
   KeySystem = false
})

-- Tambah Tab Utama
local CombatTab = Window:CreateTab("Combat", 4483362458) -- Icon ID

-- State Global untuk Fitur
_G.SilentAimEnabled = false

-- Fungsi Melacak Murderer
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function getMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if player.Character:FindFirstChild("Knife") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

-- Hooking Metatable (Hanya berjalan jika _G.SilentAimEnabled = true)
local gmt = getrawmetatable(game)
local oldNamecall = gmt.__namecall
setreadonly(gmt, false)

gmt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if _G.SilentAimEnabled and method == "FireServer" and (tostring(self) == "ShootGun" or tostring(self) == "UseGun") then
        local targetMurderer = getMurderer()
        if targetMurderer and targetMurderer.Character then
            local targetPart = targetMurderer.Character:FindFirstChild("UpperTorso") or targetMurderer.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                for i, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then
                        args[i] = targetPart.Position
                        break
                    end
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

setreadonly(gmt, true)

-- Membuat Toggle di UI Rayfield
CombatTab:CreateToggle({
   Name = "Silent Aim (Target: Murderer Dada)",
   CurrentValue = false,
   Flag = "SilentAimToggle",
   Callback = function(Value)
      _G.SilentAimEnabled = Value
      if Value then
          Rayfield:Notify({
             Title = "Silent Aim",
             Content = "Status: AKTIF! Selamat berburu Murderer.",
             Duration = 3,
             Image = 4483362458,
          })
      else
          Rayfield:Notify({
             Title = "Silent Aim",
             Content = "Status: NONAKTIF!",
             Duration = 3,
             Image = 4483362458,
          })
      end
   end,
})

-- Notifikasi sukses load UI
Rayfield:Notify({
   Title = "Sistem Siap!",
   Content = "ToBlUt GpT V1 UI Berhasil Dimuat.",
   Duration = 5,
   Image = 4483362458,
})
