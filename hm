-- ToBlUt GpT V1 - MM2 Silent Aim Sheriff 2026 Bypass
-- Target: Dada Murderer (UpperTorso / HumanoidRootPart)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Teams = game:GetService("Teams") -- Atau melacak tools jika MM2 tidak pakai Teams formal

-- Fungsi mencari player yang jadi Murderer (memegang Knife)
local function getMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            -- Cek apakah karakter memegang Knife di backpack atau di karakter
            if player.Character:FindFirstChild("Knife") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

-- Hooking Index / Namecall untuk manipulasi arah tembakan (Silent Aim)
local gmt = getrawmetatable(game)
local oldNamecall = gmt.__namecall
setreadonly(gmt, false)

gmt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    -- Mengintercept RemoteEvent tembakan milik Sheriff
    -- Catatan: Nama remote bisa berubah, sesuaikan dengan struktur game MM2 terbaru
    if method == "FireServer" and tostring(self) == "ShootGun" or tostring(self) == "UseGun" then
        local targetMurderer = getMurderer()
        
        if targetMurderer and targetMurderer.Character then
            -- Mengunci target pada bagian Dada (UpperTorso untuk R15, Torso untuk R6)
            local targetPart = targetMurderer.Character:FindFirstChild("UpperTorso") or targetMurderer.Character:FindFirstChild("HumanoidRootPart")
            
            if targetPart then
                -- Mengubah argumen posisi tembakan menuju koordinat dada Murderer
                -- Biasanya argumen pertama atau kedua adalah Vector3 posisi target
                for i, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then
                        args[i] = targetPart.Position
                        break
                    end
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

setreadonly(gmt, true)
