-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- ═══════════════════════════════════════════
-- CONFIGURATION PANEL
-- ═══════════════════════════════════════════

local CONFIG = {
    -- Core Settings
    Enabled = true,
    
    -- Target Settings
    FOVRadius = 200,              -- Pixel radius from mouse (0 = infinite range)
    TargetPart = "Head",          -- "Head" or "HumanoidRootPart" or "Torso"
    
    -- Advanced Options
    VisibleCheck = false,         -- Only shoot visible targets (through walls = false)
    PredictMovement = true,       -- Lead moving targets
    PredictionMultiplier = 0.15,  -- Bullet travel time compensation
    
    -- Visual Settings
    ShowFOV = true,               -- Draw FOV circle
    FOVColor = Color3.fromRGB(255, 255, 255),
    FOVTransparency = 0.7,
    
    -- Keybinds
    ToggleKey = Enum.KeyCode.T,   -- Press T to toggle on/off
}

-- ═══════════════════════════════════════════
-- GLOBAL VARIABLES
-- ═══════════════════════════════════════════

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local FOVCircle = nil

-- ═══════════════════════════════════════════
-- UTILITY FUNCTIONS
-- ═══════════════════════════════════════════

local function IsAlive(player)
    if not player or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function GetTargetPart(character)
    local part = character:FindFirstChild(CONFIG.TargetPart)
    if part then return part end
    
    -- Fallback hierarchy
    return character:FindFirstChild("Head") 
        or character:FindFirstChild("HumanoidRootPart") 
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
end

local function IsVisible(origin, targetPart)
    if not CONFIG.VisibleCheck then return true end
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.IgnoreWater = true
    
    local direction = (targetPart.Position - origin)
    local ray = Workspace:Raycast(origin, direction, rayParams)
    
    if ray then
        return ray.Instance:IsDescendantOf(targetPart.Parent)
    end
    
    return true
end

local function PredictPosition(targetPart)
    if not CONFIG.PredictMovement then
        return targetPart.Position
    end
    
    -- Get target velocity
    local velocity = targetPart.AssemblyVelocity or Vector3.new(0, 0, 0)
    
    -- Predict future position
    local predictedPos = targetPart.Position + (velocity * CONFIG.PredictionMultiplier)
    
    return predictedPos
end

local function WorldToScreen(position)
    local screenPos, onScreen = Camera:WorldToViewportPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

-- ═══════════════════════════════════════════
-- TARGET ACQUISITION SYSTEM
-- ═══════════════════════════════════════════

local function GetBestTarget()
    if not LocalPlayer.Character then return nil end
    
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local mousePos = UserInputService:GetMouseLocation()
    
    local closestTarget = nil
    local closestDistance = math.huge
    
    -- Iterate through all players
    for _, player in pairs(Players:GetPlayers()) do
        -- Skip self
        if player == LocalPlayer then continue end
        
        -- Check if alive
        if not IsAlive(player) then continue end
        
        local character = player.Character
        local targetPart = GetTargetPart(character)
        
        if targetPart then
            -- FOV Check
            if CONFIG.FOVRadius > 0 then
                local screenPos, onScreen = WorldToScreen(targetPart.Position)
                if not onScreen then continue end
                
                local screenDistance = (screenPos - mousePos).Magnitude
                if screenDistance > CONFIG.FOVRadius then continue end
            end
            
            -- Visibility Check
            if not IsVisible(rootPart.Position, targetPart) then continue end
            
            -- Distance Comparison (world space)
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            
            if distance < closestDistance then
                closestDistance = distance
                closestTarget = targetPart
            end
        end
    end
    
    return closestTarget
end

-- ═══════════════════════════════════════════
-- MOUSE HOOK SYSTEM
-- ═══════════════════════════════════════════

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    -- Hook Mouse.Hit and Mouse.Target
    if CONFIG.Enabled and method == "FireServer" then
        local target = GetBestTarget()
        
        if target then
            local predictedPos = PredictPosition(target)
            
            -- Modify the hit position in the arguments
            for i, arg in pairs(args) do
                if typeof(arg) == "CFrame" then
                    args[i] = CFrame.new(predictedPos)
                elseif typeof(arg) == "Vector3" then
                    args[i] = predictedPos
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

-- Alternative Mouse.Hit hook
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if CONFIG.Enabled and self == LocalPlayer:GetMouse() then
        if key == "Hit" then
            local target = GetBestTarget()
            
            if target then
                local predictedPos = PredictPosition(target)
                return CFrame.new(predictedPos)
            end
        elseif key == "Target" then
            local target = GetBestTarget()
            if target then
                return target
            end
        end
    end
    
    return oldIndex(self, key)
end)

-- ═══════════════════════════════════════════
-- FOV CIRCLE VISUAL
-- ═══════════════════════════════════════════

local function CreateFOVCircle()
    if CONFIG.ShowFOV then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Thickness = 2
        FOVCircle.NumSides = 64
        FOVCircle.Radius = CONFIG.FOVRadius
        FOVCircle.Filled = false
        FOVCircle.Color = CONFIG.FOVColor
        FOVCircle.Transparency = CONFIG.FOVTransparency
        FOVCircle.Visible = true
        FOVCircle.ZIndex = 999
    end
end

local function UpdateFOVCircle()
    if FOVCircle then
        local mousePos = UserInputService:GetMouseLocation()
        FOVCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        FOVCircle.Radius = CONFIG.FOVRadius
        FOVCircle.Visible = CONFIG.ShowFOV and CONFIG.Enabled
    end
end

-- ═══════════════════════════════════════════
-- GUI NOTIFICATION SYSTEM
-- ═══════════════════════════════════════════

local function Notify(message, duration)
    duration = duration or 3
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Silent Aim",
        Text = message,
        Duration = duration,
        Icon = "rbxassetid://2541869220"
    })
end

-- ═══════════════════════════════════════════
-- INPUT HANDLING
-- ═══════════════════════════════════════════

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Toggle Silent Aim
    if input.KeyCode == CONFIG.ToggleKey then
        CONFIG.Enabled = not CONFIG.Enabled
        
        local status = CONFIG.Enabled and "ENABLED" or "DISABLED"
        Notify("Silent Aim " .. status, 2)
        
        print("[Silent Aim] " .. status)
    end
end)

-- ═══════════════════════════════════════════
-- RENDER LOOP
-- ═══════════════════════════════════════════

RunService.RenderStepped:Connect(function()
    UpdateFOVCircle()
end)

-- ═══════════════════════════════════════════
-- INITIALIZATION
-- ═══════════════════════════════════════════

local function Initialize()
    -- Create FOV Circle
    CreateFOVCircle()
    
    -- Initial notification
    Notify("Silent Aim Loaded\nPress " .. CONFIG.ToggleKey.Name .. " to toggle", 5)
    
    -- Console output
    print("═══════════════════════════════════════════")
    print("  MM2 SILENT AIM - INITIALIZED")
    print("═══════════════════════════════════════════")
    print("Status: ENABLED")
    print("FOV Radius: " .. CONFIG.FOVRadius .. "px")
    print("Target Part: " .. CONFIG.TargetPart)
    print("Prediction: " .. tostring(CONFIG.PredictMovement))
    print("Toggle Key: " .. CONFIG.ToggleKey.Name)
    print("═══════════════════════════════════════════")
end

-- Run initialization
Initialize()

